# AWS設定
REACT_APP_AWS_REGION=ap-northeast-1

# API設定（CloudFormationデプロイ後に設定）
REACT_APP_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/dev

# Amplify Auth設定（Amplify CLI実行後に設定）
REACT_APP_USER_POOL_ID=ap-northeast-1_xxxxxxxx
REACT_APP_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
